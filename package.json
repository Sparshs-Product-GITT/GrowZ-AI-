{
  "name": "growz-ai",
  "version": "0.1.0",
  "private": true,
  "description": "GrowZ AI: Chrome extension that highlights NSE/BSE company mentions in financial news articles and shows live KPIs with a TradingView chart.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "build:dictionary": "node scripts/buildCompanyDictionary.mjs",
    "verify:indices": "node scripts/verifyIndexSymbols.mjs",
    "verify:news": "node scripts/verifyNews.mjs",
    "test": "node scripts/testMatching.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lightweight-charts": "^4.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  }
}
